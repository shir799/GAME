# Environment Variables Example
# Copy this file to .env for local development

# Development mode
VITE_DEV_MODE=true

# Enable debug logging
VITE_DEBUG=false

# Game version
VITE_GAME_VERSION=1.0.0

# Analytics (if implemented)
# VITE_ANALYTICS_ID=

# API endpoints (if implemented)
# VITE_API_URL=
